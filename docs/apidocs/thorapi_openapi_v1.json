  "components": {
    "schemas": {
      "AccountTypeResponse": {
        "required": [
          "id",
          "name",
          "description",
          "isHuman"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "isHuman": {
            "type": "boolean"
          }
        }
      },
      "AuthenticationMethodResponse": {
        "required": [
          "id",
          "typeId",
          "name",
          "description",
          "fieldIds"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "typeId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "fieldIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "AuthenticationValueRequest": {
        "required": [
          "fieldId",
          "value"
        ],
        "type": "object",
        "properties": {
          "fieldId": {
            "type": "string",
            "format": "uuid"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "ConnectorApiKeyResponse": {
        "required": [
          "keyId",
          "scope",
          "label",
          "createdAt",
          "expiresAt",
          "rawApiKey"
        ],
        "type": "object",
        "properties": {
          "keyId": {
            "type": "string",
            "format": "uuid"
          },
          "scope": {
            "type": "string"
          },
          "label": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "rawApiKey": {
            "type": "string"
          }
        }
      },
      "CreateAccountTypeRequest": {
        "required": [
          "name",
          "description",
          "isHuman"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "isHuman": {
            "type": "boolean"
          }
        }
      },
      "CreateAuthenticationMethodRequest": {
        "required": [
          "typeId",
          "name",
          "description",
          "values"
        ],
        "type": "object",
        "properties": {
          "typeId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "values": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthenticationValueRequest"
            }
          }
        }
      },
      "CreateConnectorApiKeyRequest": {
        "required": [
          "scope",
          "label",
          "expiresInDays"
        ],
        "type": "object",
        "properties": {
          "scope": {
            "type": "string"
          },
          "label": {
            "type": [
              "null",
              "string"
            ]
          },
          "expiresInDays": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CreateScanConfigRequest": {
        "required": [
          "name",
          "description",
          "sourceIds",
          "authMethodId",
          "configValues"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "authMethodId": {
            "type": "string",
            "format": "uuid"
          },
          "configValues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanConnectorConfigValueRequest"
            }
          }
        }
      },
      "CreateScanRequest": {
        "required": [
          "scanConfigId"
        ],
        "type": "object",
        "properties": {
          "scanConfigId": {
            "type": "string",
            "format": "uuid"
          },
          "scanType": {
            "type": "string",
            "default": "instant"
          }
        }
      },
      "CreateSourceRequest": {
        "required": [
          "connectorType",
          "name",
          "config"
        ],
        "type": "object",
        "properties": {
          "connectorType": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int16"
          },
          "name": {
            "type": "string"
          },
          "config": {
            "type": "string"
          }
        }
      },
      "RefreshRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "roleType"
        ],
        "type": "object",
        "properties": {
          "roleType": {
            "type": "string"
          }
        }
      },
      "ScanConfigResponse": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ScanConnectorConfigValueRequest": {
        "required": [
          "configId",
          "value"
        ],
        "type": "object",
        "properties": {
          "configId": {
            "type": "string",
            "format": "uuid"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "ScanResponse": {
        "required": [
          "scanId",
          "scanConfigId",
          "status",
          "tasks"
        ],
        "type": "object",
        "properties": {
          "scanId": {
            "type": "string",
            "format": "uuid"
          },
          "scanConfigId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanTaskResponse"
            }
          }
        }
      },
      "ScanTaskResponse": {
        "required": [
          "taskId",
          "connectorType",
          "sourceId",
          "status"
        ],
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "format": "uuid"
          },
          "connectorType": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int16"
          },
          "sourceId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "SourceResponse": {
        "required": [
          "id",
          "connectorType",
          "name",
          "config",
          "isActive",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "connectorType": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int16"
          },
          "name": {
            "type": "string"
          },
          "config": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TaskAuthResponse": {
        "required": [
          "token",
          "refreshToken",
          "roleType"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "roleType": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
